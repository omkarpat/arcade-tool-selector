{
  "enabledMcpjsonServers": ["arcade"],
  "disableClaudeAiConnectors": true,
  "permissions": {
    "defaultMode": "default"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" ats-hook user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__arcade__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" ats-hook pre-tool-use",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
