# Copy to .env in the repo root (gitignored) and `chmod 600` it. ATS_ENV_FILE overrides the path.
# Read only by ats-proxy. Real environment variables override these values.

# Arcade
ARCADE_API_KEY=arc_...
ARCADE_USER_ID=you@example.com                       # the user Arcade authorizes tools for
ATS_GATEWAY_URL=https://api.arcade.dev/mcp/<slug>    # gateway with Arcade Headers auth

# Arcade org/project: lets `ats-audit` read Arcade's tool execution log (both are in the dashboard URL)
ARCADE_ORG_ID=
ARCADE_PROJECT_ID=

# Project config
ATS_CONFIG=ats.yaml                                  # relative to the repo root; gitignored

# Judge model: OpenAI Decisions API by default; ANTHROPIC_API_KEY only if judge.chain uses anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: send audit events to OpenTelemetry instead of audit.jsonl (`uv sync --extra otel`)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
