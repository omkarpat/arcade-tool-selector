# The only local configuration. Copy to .env in the repo root (gitignored) and `chmod 600` it.
# Everything else lives on the Arcade platform: each role's purpose is its gateway's instructions.

ARCADE_USER_ID=you@example.com        # the user Arcade authorizes tools for; its domain is "inside the organization"
ARCADE_ORG_ID=                        # in the Arcade dashboard URL
OPENAI_API_KEY=                       # the scope judge (OpenAI Decisions API, gpt-6-luna)

# One Arcade project per role; ATS_ROLE=<name> picks one. Each project has its own API key and gateway
# (Arcade Headers auth). Write the role's purpose into that gateway's instructions in the dashboard.
ATS_ROLES='{
  "meeting-scheduler": {
    "project_id": "<project id>",
    "api_key": "arc_...",
    "gateway_url": "https://api.arcade.dev/mcp/<gateway>"
  }
}'

# Optional: send audit events to OpenTelemetry instead of audit.jsonl (`uv sync --extra otel`)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
