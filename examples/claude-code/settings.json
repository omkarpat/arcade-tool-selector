{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$ATS_ROLE\" ] || \"$ATS_HOME/.venv/bin/ats-hook\" user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__workspace-search__.*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$ATS_ROLE\" ] || \"$ATS_HOME/.venv/bin/ats-hook\" pre-tool-use",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
